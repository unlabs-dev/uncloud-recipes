# The Postgres account username and password to use.
POSTGRES_USER=
POSTGRES_PASSWORD=

# The database to create.
# You can still create additional databases after the cluster is created.
POSTGRES_DB=

# The password used to authenticate replication.
# This should be random and unique, not a copy of POSTGRES_PASSWORD.
POSTGRES_REPL_PASSWORD=

# The password used to authenticate etcd instances to each other.
# This should be random and unique.
ETCD_TOKEN=

# By default, etcd keeps all history of its keyspace.
# This will eventually lead to etcd reaching its default 2GB storage limit.
# This option sets the history retention (e.g. 1 hour of history) to prevent storage exhaustion.
ETCD_AUTO_COMPACTION_RETENTION=1h
